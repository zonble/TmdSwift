::SCORE::
** 月映寒江 **
!= 72
?= D
<4/4>

/* -------------------------------------------------------------
   Intro: 4 小節。竹笛吹出淒清的羽調動機，古箏點綴彈撥，弦樂幽遠鋪底。
------------------------------------------------------------- */

intro:Flute@|0| {
    <4*>
    | 6_ - (1 2)%(-) 3 | 2 - (3 2)%(-) 1 | 6_ - 1 - | 5_ - - - |
}

intro:Guzheng@|0| {
    <4*>
    | [6_m] - [4_] - | [1_] - [5_] - | [6_m] - [4_] - | [3_m] - - - |
}

intro:String@|0| {
    <4*>
    | 6_ - - - | 4_ - - - | 1_ - - - | 5_ - - - |
}

intro:Drum@|0| {
    <4*>
    | x - - - | x - - - | x - - - | x - x X |
}

/* -------------------------------------------------------------
   v1: 主歌一。8 小節（含提前 1 小節弱起進場）。
------------------------------------------------------------- */

v1:Vocal@|-1| {
    <4*>
    /*                                           寒  江  */
    | 0 0 0 (3 5)%(-) |
    /* 映  冷  月           渡  口  舟  自  橫           殘  燈  */
    | 6 - 5 3 | 2 3 1 - | 2 - (3 2)%(-) 1 | 6_ - - (3 5)%(-) |
    /* 照  孤  影           誰  在  聽  雨  聲                 */
    | 6 - 5 3 | 2 3 5 - | 3 2 1 2 | 3 - - - |
}

v1:Guzheng@|0| {
    <4*>
    | [6_m] - - - | [4_] - - - | [2_m] - - - | [6_m] - - - |
    | [6_m] - - - | [1_] - - - | [4_] - [5_] - | [3_m] - - - |
}

v1:Bass@|0| {
    <4*>
    | 6_ - - - | 4_ - - - | 2_ - - - | 6_ - - - |
    | 6_ - - - | 1 - - - | 4_ - 5_ - | 3_ - - - |
}

v1:String@|0| {
    <4*>
    | 3 - - - | 1 - - - | 6_ - - - | 3 - - - |
    | 3 - - - | 5 - - - | 6_ - 7_ - | 1 - - - |
}

v1:Drum@|0| {
    <4*>
    | x - - - | x - x - | x - - - | x - x - |
    | x - - - | x - x - | x - x - | x x X x |
}

/* -------------------------------------------------------------
   v2: 主歌二。配器層次增加，竹笛加入同度嘆息。
------------------------------------------------------------- */

v2:Vocal@|-1| {
    <4*>
    /*                                           繁  華  */
    | 0 0 0 (3 5)%(-) |
    /* 終  落  盡           歲  月  悄  無  痕           往  事  */
    | 6 - 5 3 | 2 3 1 - | 2 - (3 2)%(-) 1 | 6_ - - (3 5)%(-) |
    /* 如  煙  散           空  餘  一  盞  溫                 */
    | 6 - 5 3 | 2 3 5 - | 3 2 1 7_ | 6_ - - - |
}

v2:Flute@|-1| {
    <4*>
    | 0 0 0 (3 5)%(-) |
    | 6 - 5 3 | 2 3 1 - | 2 - (3 2)%(-) 1 | 6_ - - (3 5)%(-) |
    | 6 - 5 3 | 2 3 5 - | 3 2 1 7_ | 6_ - - - |
}

v2:Guzheng@|0| {
    <4*>
    | [6_m] - - - | [4_] - - - | [2_m] - - - | [6_m] - - - |
    | [6_m] - - - | [1_] - - - | [4_] - [5_] - | [6_m] - - - |
}

v2:Bass@|0| {
    <4*>
    | 6_ - - - | 4_ - - - | 2_ - - - | 6_ - - - |
    | 6_ - - - | 1 - - - | 4_ - 5_ - | 6_ - - - |
}

v2:String@|0| {
    <4*>
    | 3 - - - | 1 - - - | 6_ - - - | 3 - - - |
    | 3 - - - | 5 - - - | 4 - 5 - | 6 - - - |
}

v2:Drum@|0| {
    <4*>
    | x x X x | x x X x | x x X x | x x X x |
    | x x X x | x x X x | x x X x | (xxxx)%(--) (xxxxXX)%(--) |
}

/* -------------------------------------------------------------
   c1: 副歌。8 小節。旋律八度高揚，鼓組進入全開的大鼓軍鼓推進。
------------------------------------------------------------- */

c1:Vocal@|0| {
    <4*>
    /* 嘆  一  生           幾  番  聚  散       幾  悲  歡           */
    | 1^ - 7 6 | 5 6 3 - | 2 3 5 6 | 3 - - - |
    /* 留  不  住           指  尖  流  年       似  雲  煙           */
    | 6 - 5 3 | 2 3 1 - | 2 3 1 7_ | 6_ - - - |
    /* 借  一  縷           東  風  吹  醒       夢  中  仙           */
    | 1^ - 7 6 | 5 6 3 - | 2 3 5 6 | 3 - - - |
    /* 換  來  世           與  你  再  續       舊  時  緣           */
    | 6 - 5 3 | 2 3 5 - | 3 2 1 7_ | 6_ - - - |
}

c1:Flute@|0| {
    <4*>
    | 1^ - 7 6 | 5 6 3 - | 2 3 5 6 | 3 - - - |
    | 6 - 5 3 | 2 3 1 - | 2 3 1 7_ | 6_ - - - |
    | 1^ - 7 6 | 5 6 3 - | 2 3 5 6 | 3 - - - |
    | 6 - 5 3 | 2 3 5 - | 3 2 1 7_ | 6_ - - - |
}

c1:Guzheng@|0| {
    <4*>
    | [4] - - - | [1] - - - | [5] - - - | [6m] - - - |
    | [4] - - - | [1] - - - | [4] - [5] - | [6m] - - - |
    | [4] - - - | [1] - - - | [5] - - - | [6m] - - - |
    | [4] - - - | [1] - - - | [2m] - [3m] - | [6m] - - - |
}

c1:Bass@|0| {
    <4*>
    | [4_] [4_] [4_] [4_] | [1_] [1_] [1_] [1_] | [5_] [5_] [5_] [5_] | [6_] [6_] [6_] [6_] |
    | [4_] [4_] [4_] [4_] | [1_] [1_] [1_] [1_] | [4_] [4_] [5_] [5_] | [6_] [6_] [6_] [6_] |
    | [4_] [4_] [4_] [4_] | [1_] [1_] [1_] [1_] | [5_] [5_] [5_] [5_] | [6_] [6_] [6_] [6_] |
    | [4_] [4_] [4_] [4_] | [1_] [1_] [1_] [1_] | [2_] [2_] [3_] [3_] | [6_] [6_] [6_] [6_] |
}

c1:String@|0| {
    <4*>
    | 6 - - - | 5 - - - | 7 - - - | 1^ - - - |
    | 6 - - - | 5 - - - | 4 - 5 - | 6 - - - |
    | 6 - - - | 5 - - - | 7 - - - | 1^ - - - |
    | 6 - - - | 5 - - - | 4 - 5 - | 6 - - - |
}

c1:Drum@|0| {
    <4*>
    | C S D S | S S D S | C S D S | S S D S |
    | C S D S | S S D S | C S D S | (SSSS)%(--) (SSSSSSBS)%(--) |
    | C S D S | S S D S | C S D S | S S D S |
    | C S D S | S S D S | C S D S | (SSSSSSSC)%(----) |
}

/* -------------------------------------------------------------
   Bridge: 4 小節。間奏沉澱，古箏與笛子對答。
------------------------------------------------------------- */

bridge:Flute@|0| {
    <4*>
    | 3 - (5 6)%(-) 1^ | 6 - (5 3)%(-) 2 | 3 - (2 1)%(-) 6_ | 5_ - - - |
}

bridge:Guzheng@|0| {
    <4*>
    | [4_] - [5_] - | [6_m] - - - | [4_] - [5_] - | [3_m] - - - |
}

bridge:Bass@|0| {
    <4*>
    | 4_ - 5_ - | 6_ - - - | 4_ - 5_ - | 3_ - - - |
}

bridge:String@|0| {
    <4*>
    | 1 - 2 - | 3 - - - | 1 - 2 - | 7_ - - - |
}

bridge:Drum@|0| {
    <4*>
    | x x X x | x x X x | x x X x | B B B B |
}

/* -------------------------------------------------------------
   Outro: 4 小節。笛音漸遠，古箏餘音繞樑，歸於寧靜。
------------------------------------------------------------- */

outro:Flute@|0| {
    <4*>
    | 6_ - 1 - | 2 - (3 2)%(-) 1 | 6_ - - - | - - - - |
}

outro:Guzheng@|0| {
    <4*>
    | [6_m] - - - | [4_] - - - | [6_m] - - - | - - - - |
}

outro:String@|0| {
    <4*>
    | 3 - - - | 1 - - - | 6_ - - - | - - - - |
}

outro:Drum@|0| {
    <4*>
    | x - - - | x - - - | x - - - | - - - - |
}

/* -------------------------------------------------------------
   Playback Order
------------------------------------------------------------- */

-> intro -> v1 -> v2 -> c1 -> bridge -> c1 -> outro -> #
