::SCORE::
** The ZONBLE Fugue: Baroque Chamber Orchestra **
!= 106
?= C
<4/4>

/* ==============================================================================
 * 【The ZONBLE Baroque Chamber Fugue】
 *
 * 徹底移除生硬乾扁的鋼琴與敲擊樂器！
 * 採用溫潤巴洛克室內樂團：
 *   - 木管組：長笛（Flute）、雙簧管（Oboe）
 *   - 弦樂組：第一小提琴（Violin1）、第二小提琴（Violin2）、中提琴（Viola）、
 *             大提琴（Cello）、低音提琴（Bass）
 *   - 低音踏板：管風琴柔和低音管（Organ Pedal）作為空氣感鋪底
 * ============================================================================== */

/* ------------------------------------------------------------------------------
 * Section 1: Flute Solo Dux (長笛吹出輕盈靈動的 ZONBLE 主題)
 * ------------------------------------------------------------------------------ */
expo1:Flute@|+1|{
    <4*>
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 2 3 4 5 | 3 - - - |
}

expo1:Strings@|0|{
    <2*>
    /* 柔和弦樂如微風般的長音和聲支撐 */
    1 5_ | 1 1 | 4_ 5_ | 1 1 |
    1 5_ | 1 1 | 2_ 5_ | 1 1 |
}

/* ------------------------------------------------------------------------------
 * Section 2: Comes (雙簧管 Oboe 於屬調歌唱 + 長笛對題跳躍 + 大提琴如歌伴奏)
 * ------------------------------------------------------------------------------ */
expo2:Oboe@|+1|{
    <4*>
    /* 雙簧管帶有些許甘甜哀愁的屬調答題 */
    2 - 5 - | #4 6 3 7 | 1 7 6 - | 5 - - - |
    2 - 5 - | #4 6 3 7 | 6 7 1 2 | 7 - - - |
}

expo2:Flute@|+1|{
    <4*>
    /* 長笛對題跳躍對位 */
    3 4 5 3 | 2 3 4 2 | 1 2 3 1 | 7_ 1 2 7_ |
    1 3 5 1^| 7 6 5 4 | 3 5 4 2 | 1 - - - |
}

expo2:Cello@|-1|{
    <4*>
    /* 大提琴溫暖抒情撥奏與弓弦交織 */
    1 - 3 - | 2 - 5 - | 1 - 4 - | 1 - - - |
    1 - 3 - | 2 - 5 - | 6 - 5 - | 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 3: Violin & Viola Entry (小提琴高歌 + 中提琴呼應 + 木管交織)
 * ------------------------------------------------------------------------------ */
expo3:Violin1@|+1|{
    <4*>
    /* 第一小提琴奏出主調 ZONBLE 主題 */
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 2 3 4 5 | 1 - - - |
}

expo3:Violin2@|0|{
    <4*>
    /* 第二小提琴柔美對位 */
    1 - 3 - | 2 4 1 7_| 1 2 7_ - | 3 5 1 - |
    1 - 3 - | 2 4 1 7_| 6_ 7_ 1 2| 1 - - - |
}

expo3:Viola@|0|{
    <4*>
    3 - 5 - | 4 - 3 - | 2 1 7_ - | 1 - - - |
    3 - 5 - | 4 - 3 - | 2 3 4 2  | 3 - - - |
}

expo3:Flute@|+1|{
    <4*>
    1^ - 7 - | 6 - 5 - | 4 - 3 - | 2 - 1 - |
    3 4 5 1^ | 7 - 6 - | 5 4 3 2 | 1 - - - |
}

expo3:Cello@|-1|{
    <4*>
    1 - - - | 2 - - - | 4 - 5 - | 1 - - - |
    1 - - - | 2 - - - | 4 - 5 - | 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 4: Tutti String & Woodwind (大提琴與低音提琴承接主題，全團壯麗歌唱)
 * ------------------------------------------------------------------------------ */
expo4:Cello@|-1|{
    <4*>
    /* 大提琴低音深情宣讀主題 */
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 4 5 5_ 5_| 1 - - - |
}

expo4:Bass@|-2|{
    <4*>
    /* 低音提琴低八度厚實襯底 */
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 4 5 5_ 5_| 1 - - - |
}

expo4:Flute@|+1|{
    <8*>
    5 1 3 5  1^ 5 3 1 | 7 2 4 7  2^ 7 4 2 | 6 1 4 6  1^ 6 4 1 | 5 1 3 5  1^ - - - |
    5 1 3 5  1^ 5 3 1 | 7 2 4 7  2^ 7 4 2 | 4 6 1 4  5 7 2 5  | 1 3 5 1^  - - - - |
}

expo4:Oboe@|+1|{
    <4*>
    3 - 5 - | 4 - 3 - | 2 - 4 - | 3 - - - |
    3 - 5 - | 4 - 3 - | 2 3 4 2 | 1 - - - |
}

expo4:Violin1@|+1|{
    <4*>
    1^ - 3^ - | 2^ 4^ 1^ 7 | 1^ 2^ 7 - | 3^ 5^ 1^ - |
    1^ - 3^ - | 2^ 4^ 1^ 7 | 6 7 1^ 2^ | 1^ - - - |
}

expo4:Viola@|0|{
    <4*>
    1 - 3 - | 2 - 1 - | 6_ - 7_ - | 1 - - - |
    1 - 3 - | 2 - 1 - | 4 3 2 5_  | 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 5: Stretto & Grand Chorale (密接和應追逐，管弦大齊奏輝煌結尾)
 * ------------------------------------------------------------------------------ */
stretto:Flute@|+1|{
    <4*>
    5 - 1 - | 7 2 6 3 | 5 - 1 - | 7 2 6 3 | 2 3 4 5 | [1 3 5 1^] - - - |
}

stretto:Oboe@|+1|{
    <4*>
    - 5 - 1 | - 7 2 6 | 3 4 5 - | 7 2 6 3 | 7 1 2 7_| [5 1 3 5] - - - |
}

stretto:Violin1@|+1|{
    <4*>
    - - 5 - | 1 - 7 2 | 6 3 2 - | 1 - 7 2 | 5 5 5 4 | [3 5 1 3] - - - |
}

stretto:Viola@|0|{
    <4*>
    - - - 5 | - 1 - - | 4 - 5 - | 1 - - - | 4 - 5 - | [1 3 5 1] - - - |
}

stretto:Cello@|-1|{
    <4*>
    - - - - | 5 - 1 - | 4 - 5 - | 1 - - - | 4 - 5 - | 1 - - - |
}

stretto:Bass@|-2|{
    <4*>
    - - - - | 5 - 1 - | 4 - 5 - | 1 - - - | 4 - 5 - | 1 - - - |
}

/* 執行進行管道 */
-> expo1
-> expo2
-> expo3
-> expo4
-> stretto ->#
