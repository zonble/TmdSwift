/* =============================================================
   VIII. 尾奏（Ending）
   浪潮退去，鼓與管樂沉寂。回到最開頭的那台鋼琴與一把大提琴，
   最後在溫暖延綿的 Emaj7 大七和弦中，向巨人致上永恆的敬意。
   ============================================================= */

end:piano@|0| {
    <4*>
    /*多  麼 希 望   我可   以                 多   麼希  望   我 能夠 */
    | 4 - 4 1 | 1^ - 4 6 | 5 - - -| - - - - | 2 - 2 5_ | 5 - 6 5 | 3 - - -| - - - - |
    /*多  麼 希 望   我    可以       對誰說    一 句          我 能 夠 */
    | 4 - 4 1 | 1^ - 7 6 | 5 3 - - | 6 5 5 3 | 5 2 - - | 0 - 1 7_ | 6_ -  - - | - - - - |
}

end:Cello-Solo@|0| {
    <4*>
    | 4_ - - - | - - - - | 5_ - - - | - - - - |
    | 2_ - - - | - - - - | 3_ - - - | - - - - |
    | 4_ - - - | - - - - | 5_ - - - | - - - - |
    | 2_ - - - | 5_ - - - | 1_ - - - | - - - - |
}

