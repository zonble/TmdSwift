    | [4] - - - | [1] - - - | [2m] - - - | [5] - - - |
    | [1] - - - | [5] - - - | [6m] - - - | [1] - - - |
    | [4] - - - | [5] - - - | [6m] - - - | [5] - - - |
}

v2:Bass@|0| {
    <4*>
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - | 2__ - - - | 5__ - - - |
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 5__ - - - | 6__ - - - | 5__ - - - |
}

/* 宇宙與熱寂的冷冽弦樂氛圍 */
v2:Strings-Cosmos@|0| {
    <4*>
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 1 - - - | 6_ - - - | 7_ - - - |
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 2 - - - | 3 - - - | 2 - - - |
}

