    | [4_] [4_] [4_] [4_] | [4_] [4_] [4_] [4_] | [5_] [5_] [5_] [5_] | [5_] [5_] [5_] [5_] |
    | [1] [1] [1] [1] | [1] [1] [1] [1] | [6_] [6_] [6_] [6_] | [6_] [6_] [6_] [6_] |
