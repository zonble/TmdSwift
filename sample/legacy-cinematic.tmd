    <4*>
    | [4] - [4] - | [4] - [4] - | [3m] - [3m] - | [3m] - [3m] - |
    | [2m] - [2m] - | [2m] - [2m] - | [6m] - [6m] - | [6m] - [6m] - |
    | [4] - [4] - | [4] - [4] - | [3m] - [3m] - | [3m] - [3m] - |
    | [2m] - [2m] - | [5] - [5] - | [1] - [1] - | [5] - - - |
}

