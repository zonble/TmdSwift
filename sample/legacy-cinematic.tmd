    | x - - - | x - - - | x - - - | x - x - |
    | x - - - | x - - - | x - - - | x - - - |
    | x - - - | x - - - | x - - - | (xxxx)%(--) X - |
}

/* =============================================================
   IV. 主歌三（v3: 16 小節）
   自省與物理法則：大鼓像沉重的心跳一拍一拍推進，弦樂中提琴
   以切分音湧動，能量開始向地心凝聚。
   ============================================================= */

v3:piano@|-1| {
    <4*>
    /*  我一向  都  平     凡   無     奇*/
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  我根本  都  無     足   輕     重*/
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   居    然   從來  沒   想過*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1  0 0 |
    /* 物 理   法則       對  誰 都  適用    */
    | 5 - 3 - | 2 5_ 0 0 | 5 - 5 6 | 5 3 - - |
}

v3:Bass@|0| {
    <4*>
    | 4__ - - - | 4__ - - - | 3__ - - - | 3__ - - - |
    | 2__ - - - | 2__ - - - | 6__ - - - | 6__ - - - |
    | 4__ - - - | 4__ - - - | 3__ - - - | 3__ - - - |
    | 2__ - - - | 5__ - - - | 1_ - - - | 5__ - - - |
}

