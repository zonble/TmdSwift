::SCORE::
** Legacy (Cinematic Art-Pop Version) **
! = 125
? = E
<4/4>

/* =============================================================
   I. 引子（Intro: 8 小節）
   深夜琴房的私語：孤獨的鋼琴試探著彈出主題，大提琴在極低音區
   拉出滄桑的長音泛音，空間極度留白。
   ============================================================= */

intro:Piano-Solo@|0| {
    <4*>
    /* 鋼琴試探性地彈出主題動機 */
    | 0 0 0 0 | 0 3 2 1 | 2 1 - - | - - - - |
    | 0 0 0 0 | 0 3 2 1 | 2 1 6_ - | - - - - |
}

intro:Cello-Sustain@|0| {
    <4*>
    | 1__ - - - | - - - - | 6___ - - - | - - - - |
    | 4___ - - - | - - - - | 5___ - - - | - - - - |
}

intro:Strings-Ambient@|0| {
    <4*>
    | - - - - | - - - - | 3 - - - | - - - - |
    | 1 - - - | - - - - | 7_ - - - | - - - - |
}

/* =============================================================
   II. 主歌一（v1: 16 小節）
   原曲旋律完全不動（@|-1| 弱起進場）。
   配器採極簡主義（Minimalism）：鋼琴伴奏晶瑩透明，大提琴如嘆息般
   在句尾補上一記低音，貝斯與鼓組完全靜默，營造無比私密的告白感。
   ============================================================= */

v1:piano@|-1| {
    <4*>
    /* 多希望  能 夠        一直       牽巨   人的手 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-)  2 1 | 2 1 5_ - |
    /* 一直在  燈  塔     照  耀    中*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        一直      仰望   我的      英雄 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /*  永遠都  看   不     見    他們  凋 落*/
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v1:Piano-Accomp@|0| {
    <4*>
    | 1 3 5 3 | 7_ 3 5 3 | 6_ 3 5 3 | 5_ 3 5 3 |
    | 4_ 1 4 1 | 3_ 1 3 1 | 2_ 6_ 2 6_ | 5_ 2 5 2 |
    | 1 3 5 3 | 7_ 3 5 3 | 6_ 3 5 3 | 5_ 3 5 3 |
    | 4_ 1 4 1 | 5_ 2 5 2 | 6_ 3 6 3 | 5_ - - - |
}

v1:Cello@|0| {
    <4*>
    | - - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - | 2__ - - - | 5__ - - - |
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 5__ - - - | 6__ - - - | - - - - |
}

/* =============================================================
   III. 主歌二（v2: 16 小節）
   旋律原封不動（鋼琴與單簧管重疊）。
   加入木吉他（NylonGuitar）八分音符分解，象徵時間的流動；
   唱到「熱寂」時，冷色調弦樂長音浮現，鼓組以極輕的踩鑔推進。
   ============================================================= */

v2:piano@|-1| {
    <4*>
    /* 多希望  能 夠        還可      以繼  續犯錯 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直有   原   諒   和   寬    容*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        稍微      理解   這個      宇宙*/
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /* 有沒有   熱   寂     以    外的  結果 */
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v2:Clarinet@|-1| {
    <4*>
    /* 多希望  能 夠        還可      以繼  續犯錯 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直有   原   諒   和   寬    容*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        稍微      理解   這個      宇宙*/
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /* 有沒有   熱   寂     以    外的  結果 */
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

