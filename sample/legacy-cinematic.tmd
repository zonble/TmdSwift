    <4*>
    | 1 - - - | - - - - | 7_ - - - | - - - - |
    | 6_ - - - | - - - - | 5_ - - - | - - - - |
    | 1 - - - | - - - - | 7_ - - - | - - - - |
    | 6_ - - - | 7_ - - - | 1 - - - | - - - - |
}

/* 動機輕聲在遠方最後一次呼應，隨後消融在琴音裡 */
end:Motif-Farewell@|-1| {
    <4*>
    | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 - - | 0 3 2 1 | 2 1 1 - | 
}

/* =============================================================
   曲式流程
   ============================================================= */

-> intro -> v1 -> v2 -> v3 -> v4 -> c1 -> b1 -> v4 -> c1 -> end -> #
