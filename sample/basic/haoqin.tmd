::SCORE::
** 豪情 **

!= 120
?= B
<4/4>

Verse1:Piano@|0|{
    <8*>
    /* 蔚藍的天空 坦蕩心胸 燦爛的陽光 炙熱豪情 */
    | 5 - 3 4 5 - 1^ - | 6 7 1^ 6 5 - - - | 5 - 3 4 5 - 3^ -  | 4^ 3^ 2^ 1^ 2^ - - - |
    /* 大海茫茫 呼我揚帆 白雲朵朵 喚我出征 */
    | 5 - 5 - 3^ - 2^- | 1^ 2^ 7 5 6 - - - | 7 6 5 6 7 7 - 1^ | 2^ - - - - - - 0    |
}

Verse2:Piano@|0|{
    <8*>
    /* 誰沒有做過那關山夢 誰沒有興起過塞上行 */
    | 5 - 3 4 5 1^ - 1^ | 6 7 1^ 6 5 - - - | 5 - 3 4 5 3^ - 3^  | 4^ 3^ 2^ 1^ 2^ - - - |
    /* 大地留下 男兒足跡 歷史何需刻上英名 */
    | 5 - 5 - 3^ - 2^- | 1^ 2^ 7 5 6 - - - | 7 6 5 6 7 5 - 2^ | 1^ - - - - - - 0    |
}

Verse3:Piano@|0|{
    <8*>
    /* 沙場的冷月  陪我獨醒 */
    | 6 - - - 3 - - 3 | 6 - 1^ - - - - 6 | 1^ - 7 - 6 - - 5' | 6 - - - - - - - |
    /* 拂曉的寒風 伴我遠行 征帆 */
    | 2^ - - - 6 - - 6 | 2^ - 4^ - - - - 2^ | 3^ - 2^ - 1^ - - 2^ | 3^ - - - - - 3 5|
    /* 掀起千層波浪 展翅飛向萬里長空 */
    | 3^ - - 2^ 1^ 2^ 1^ 7 | 6 - - - - - 7 6 | 5 - - 6 1^ 7 - 1^ | 2^ - - - - - - 0 |
}


Verse4:Piano@|0|{
    <8*>
    /* 誰沒有做過那關山夢 誰沒有興起過塞上行 */
    | 5 - 3 4 5  1^ - 1^ | 6 7 1^ 6 5 - - - | 5 - 3 4 5  3^ - 3^  | 4^ 3^ 2^ 1^ 2^ - - - |
    /* 大地留下 男兒足跡 歷史何需刻上英名 */
    | 5 - 5 - 3^ - 2^- | 1^ 2^ 7 5 6 - - - | 7 6 5 6 7 3^ - 2^ | 1^ - - - - - - -    |
}


-> Verse1 -> Verse2 -> Verse3 -> Verse4 -> #